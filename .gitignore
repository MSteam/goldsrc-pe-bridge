# Whitelist: only sources are tracked. Everything else in this folder is local
# (Valve/mod binaries, build output, logs, backups, research notes).
/*
!/.gitignore
!/.gitmodules
!/README.md
!/BUILD.md
!/build_settings.mk
!/halflife
!/client_bridge/
!/gunman_bridge/
!/pe_runtime/
!/scout/
/client_bridge/*
!/client_bridge/Makefile
!/client_bridge/src/
!/client_bridge/tests/
!/client_bridge/tools/
/gunman_bridge/*
!/gunman_bridge/Makefile
!/gunman_bridge/src/
!/gunman_bridge/tests/
!/gunman_bridge/tools/
/pe_runtime/*
!/pe_runtime/Makefile
!/pe_runtime/src/
!/pe_runtime/tools/
/scout/*
!/scout/tools/
# Machine-specific debugging and Steam-installation helpers, unused tests.
*.gdb
/client_bridge/tools/runtime_gdb.sh
/client_bridge/tools/host_runtime_test.sh
/client_bridge/tools/install_steam_hook.py
/client_bridge/tools/snapshot_steam_windows.py
/client_bridge/tools/probe_native_mouse.py
/client_bridge/tools/verify_*_regression.py
/client_bridge/tools/test.sh
/client_bridge/tools/test_native.sh
/client_bridge/tools/prepare_test_game.py
/client_bridge/tests/abi_probe.cpp
/client_bridge/tests/freetype.c
/client_bridge/tests/locale.c
/gunman_bridge/tools/test_steam.py
/gunman_bridge/tools/test_native.sh
/gunman_bridge/tools/prepare_test_game.py
/gunman_bridge/tools/loadlibrary.patch
/gunman_bridge/tests/elf32_probe.c
__pycache__/
