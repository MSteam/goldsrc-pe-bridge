# Whitelist: only sources are tracked. Everything else in this folder is local
# (Valve/mod binaries, build output, logs, backups, research notes).
/*
!/.gitignore
!/.gitmodules
!/README.md
!/BUILD.md
!/build_settings.mk
!/halflife
!/client_bridge/
!/server_bridge/
!/pe_runtime/
!/scout/
/client_bridge/*
!/client_bridge/Makefile
!/client_bridge/vgui.def
!/client_bridge/src/
!/client_bridge/tests/
!/client_bridge/tools/
/server_bridge/*
!/server_bridge/Makefile
!/server_bridge/src/
!/server_bridge/tests/
!/server_bridge/tools/
/pe_runtime/*
!/pe_runtime/Makefile
!/pe_runtime/src/
!/pe_runtime/tools/
/scout/*
!/scout/tools/
__pycache__/
